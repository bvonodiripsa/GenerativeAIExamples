DECLARE @rc  INT,
        @vec VECTOR(1024);

EXEC @rc = dbo.nvidia_run_ai_embedding
           @ModelName  = N'EmbedE5_OpenAI',
           @Prompt     = N'Покажите лучшие товары для езды по пересечённой местности.',
           @OutVector  = @vec OUTPUT;

    /*
      For performance, ensure a vector index exists:
      CREATE VECTOR INDEX IX_pde_Embedding ON Production.ProductDescriptionEmbeddings(Embedding)
      WITH (DISTANCE_FUNCTION = COSINE);
    */

IF @rc = 0
BEGIN
  SELECT TOP (20)
         p.Name,
         pd.Description,
         p.SafetyStockLevel,
         vector_distance('cosine', pde.Embedding, @vec) AS distance
  FROM Production.ProductDescriptionEmbeddings AS pde
  JOIN Production.Product             AS p  ON p.ProductID = pde.ProductID
  JOIN Production.ProductDescription  AS pd ON pd.ProductDescriptionID = pde.ProductDescriptionID
  WHERE p.SafetyStockLevel >= 100
  ORDER BY distance ASC;
END
